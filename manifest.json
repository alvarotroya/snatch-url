{
  "manifest_version": 3,
  "name": "Snatch URL",
  "version": "1.0.0",
  "description": "Edit the current tab's path segments and query parameters from a popup, and navigate to the result.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "snatch-url@alvarotroya.github.io",
      "strict_min_version": "115.0"
    }
  }
}
